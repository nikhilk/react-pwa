{
  "name": "app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "app": {
    "title": "Hello World!",
    "name": "Hello World",
    "shortName": "Hello World",
    "description": "A simple, hello world style, installable progressive web app",
    "themeColor": "#ffffff",
    "backgroundColor": "#ffffff",
    "servingRepo": "git@github.com:nikhilk/react-pwa.git"
  },
  "scripts": {
    "dev:build": "npx bun run tools/dev.ts",
    "dev:serve": "npx bun run tools/dev.ts 4001",
    "pub:build": "npx bun run tools/pub.ts",
    "pub:serve": "npx bun run tools/pub.ts && npx serve public -l 4000",
    "pub:pushg": "npx bun run tools/pub.ts && npx bun run tools/pushg.ts"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "bun": "latest",
    "serve": "^14.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
